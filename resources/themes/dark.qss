/* Dark Theme (深色高对比度质感主题) */

#workshopInterface {
    background-color: #18181b;
}

ControlSidebar {
    background: transparent;
    border: none;
}

CardWidget {
    background-color: #27272a;
    border: 1px solid #3f3f46;
    border-radius: 8px;
}

SubtitleLabel {
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
}

BodyLabel {
    color: #f4f4f5;
    font-size: 12px;
    font-weight: normal;
}

RadioButton {
    color: #f4f4f5;
    font-size: 12px;
}

RadioButton:hover {
    color: #ffffff;
}

SpinBox {
    background-color: #333338;
    color: #ffffff;
    border: 1px solid #52525b;
    border-radius: 5px;
    padding: 2px 6px;
    font-weight: bold;
    font-size: 12px;
}

LineEdit {
    background-color: #333338;
    color: #ffffff;
    border: 1px solid #52525b;
    border-radius: 5px;
    padding: 4px 8px;
    font-size: 12px;
}

PushButton {
    background-color: #38383e;
    color: #ffffff;
    border: 1px solid #52525b;
    border-radius: 5px;
    font-size: 11px;
}

PushButton:hover {
    background-color: #44444c;
    border-color: #00bcd4;
    color: #ffffff;
}

PushButton:pressed {
    background-color: #27272a;
    color: #d4d4d8;
}

PrimaryPushButton {
    background-color: #00bcd4;
    color: #000000;
    font-weight: bold;
    font-size: 13px;
    border-radius: 6px;
}

PrimaryPushButton:hover {
    background-color: #22d3ee;
}

QSplitter::handle {
    background-color: #27272a;
    border: 1px solid #3f3f46;
    border-radius: 3px;
    margin: 0px 2px;
}

QSplitter::handle:hover {
    background-color: #00bcd4;
}

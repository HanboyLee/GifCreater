/* Light Theme (浅色高对比度明亮主题) */

#workshopInterface, #promptInterface, #settingsInterface {
    background-color: #f4f4f5;
}

ListWidget, QListWidget {
    background-color: #ffffff;
    color: #09090b;
    border: 1px solid #e4e4e7;
    border-radius: 6px;
}
ListWidget::viewport, QListWidget::viewport {
    background-color: #ffffff;
}

ListWidget::item, QListWidget::item {
    color: #09090b;
    background: transparent;
}

ListWidget::item:selected, QListWidget::item:selected {
    background-color: #e4e4e7;
    color: #09090b;
}

ControlSidebar {
    background: transparent;
    border: none;
}

CardWidget {
    background-color: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 8px;
}

SubtitleLabel {
    color: #09090b;
    font-size: 13px;
    font-weight: bold;
}

BodyLabel {
    color: #18181b;
    font-size: 12px;
    font-weight: normal;
}

RadioButton {
    color: #18181b;
    font-size: 12px;
}

RadioButton:hover {
    color: #000000;
}

SpinBox {
    background-color: #ffffff;
    color: #09090b;
    border: 1px solid #d4d4d8;
    border-radius: 5px;
    padding: 2px 6px;
    font-weight: bold;
    font-size: 12px;
}

LineEdit {
    background-color: #ffffff;
    color: #09090b;
    border: 1px solid #d4d4d8;
    border-radius: 5px;
    padding: 4px 8px;
    font-size: 12px;
}

PushButton {
    background-color: #f4f4f5;
    color: #18181b;
    border: 1px solid #d4d4d8;
    border-radius: 5px;
    font-size: 11px;
}

PushButton:hover {
    background-color: #e4e4e7;
    border-color: #0097a7;
    color: #000000;
}

PushButton:pressed {
    background-color: #d4d4d8;
    color: #27272a;
}

PrimaryPushButton {
    background-color: #00bcd4;
    color: #000000;
    font-weight: bold;
    font-size: 13px;
    border-radius: 6px;
}

PrimaryPushButton:hover {
    background-color: #22d3ee;
}

QSplitter::handle {
    background-color: #e4e4e7;
    border: 1px solid #d4d4d8;
    border-radius: 3px;
    margin: 0px 2px;
}

QSplitter::handle:hover {
    background-color: #0097a7;
}
